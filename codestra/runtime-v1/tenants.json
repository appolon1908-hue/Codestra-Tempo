{
  "schemaVersion": "1.0",
  "header": "X-Scope-OrgID",
  "defaultTenant": "platform",
  "allowedTenants": [
    "platform",
    "codestra",
    "moneybee",
    "beyvra",
    "breero",
    "larim-a",
    "transportation",
    "booked4seasons",
    "social",
    "klyrow",
    "telnexa",
    "kyqra",
    "restaurant",
    "provisioning"
  ],
  "requiredResourceAttributes": [
    "codestra_business",
    "application",
    "service.name",
    "service.version",
    "deployment.environment",
    "server",
    "region",
    "deployment"
  ],
  "forbiddenSpanAttributes": [
    "http.request.header.authorization",
    "http.request.header.cookie",
    "http.response.header.set-cookie",
    "db.statement.raw",
    "enduser.email",
    "enduser.phone",
    "payment.card.number",
    "broker.api_secret",
    "broker.signing_key"
  ],
  "rules": {
    "customerIdsAreTenantIds": false,
    "customerIdsAreIndexedAttributes": false,
    "requestBodiesCaptured": false,
    "responseBodiesCaptured": false,
    "beyvraTradeCredentialsAllowed": false,
    "crossBusinessTraceQueriesAllowedByDefault": false
  }
}
