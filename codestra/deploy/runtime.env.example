# Non-secret Tempo runtime contract.
# Credentials and trust material are external secret files and must not be committed.

CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=hetzner-eu
CODESTRA_DEPLOYMENT_ID=replace-with-immutable-release-id

# Complete immutable image references containing @sha256:...
GO_BUILDER_IMAGE=golang:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_REAL_DIGEST
TEMPO_BASE_IMAGE=grafana/tempo:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_REAL_DIGEST
CODESTRA_TEMPO_IMAGE=ghcr.io/appolon1908-hue/codestra-tempo:REPLACE_WITH_RELEASE@sha256:REPLACE_WITH_REAL_DIGEST

TEMPO_QUERY_HOST_PORT=3200
TEMPO_S3_ENDPOINT=replace-with-private-s3-endpoint
TEMPO_S3_BUCKET=replace-with-tempo-traces-bucket
TEMPO_S3_REGION=us-east-1
TEMPO_S3_INSECURE=false
TEMPO_MEMCACHED_ADDRESSES=dns+memcached:11211
TEMPO_PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write

CODESTRA_OBSERVABILITY_NETWORK=codestra-observability

# External secret object names only.
TEMPO_S3_CREDENTIALS_SECRET_NAME=tempo-s3-credentials
TEMPO_S3_CA_SECRET_NAME=tempo-s3-ca
